{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "goosnav-canvas",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  "vars": { "PIXEL_RATE_LIMIT": "browser" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "BOARD", "class_name": "CanvasBoard" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CanvasBoard"] }]
}
